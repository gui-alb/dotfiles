// https://niri-wm.github.io/niri/Configuration:-Input
input {
    keyboard {
		repeat-rate 35
		repeat-delay 200

        xkb {
            layout "us(altgr-intl)"
        }

        numlock
    }

    touchpad {
        // off
        tap
        // dwt
        // dwtp
        // drag false
        // drag-lock
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "two-finger"
        // disabled-on-external-mouse
    }

    mouse {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "no-scroll"
    }

    trackpoint {

    }

    focus-follows-mouse max-scroll-amount="0%"
}
